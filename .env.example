# Copy to .env and fill in. Never commit .env — it's gitignored.
# cp .env.example .env

# ── Upstream ───────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# ── Auth ───────────────────────────────────────────────────
# Static bearer token clients send to our gateway. Any string.
BIFROST_API_KEY=dev-local-key

# ── Database ───────────────────────────────────────────────
# Local docker-compose default. Swap for the Neon URL in prod.
DATABASE_URL=postgresql://bifrost:bifrost@localhost:5432/bifrost

# ── Services ───────────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_URL=http://localhost:8080

ML_PORT=8000
ML_SERVICE_URL=http://localhost:8000

WEB_PORT=3000

# ── Routing ────────────────────────────────────────────────
# The model all savings are measured against. Must stay fixed —
# every "we saved $X" number on the dashboard is relative to this.
BASELINE_MODEL=openai/gpt-5.5

# Fallback if the ML service is unreachable.
DEFAULT_MODEL=openai/gpt-5-mini

# Default cost/quality tradeoff. 0 = pure quality, 1 = pure cost.
DEFAULT_LAMBDA=0.5

# ── ML ─────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KNN_K=10
