# Copy to .env.local (never commit .env.local).
# cp .env.example .env.local

# Gateway the Next.js server calls. The browser never sees these.
GATEWAY_URL=http://localhost:8080
BIFROST_API_KEY=dev-local-key

# 1 = skip the gateway (fake chat + fake /preview). Demo slider still works.
# 0 = call GATEWAY_URL /v1/chat/completions and /v1/route/preview
BIFROST_MOCK=1
